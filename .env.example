# Database Configuration
DATABASE_URL=postgresql+psycopg2://zt_user:zt_password@localhost:5432/zt_db

# Development shortcuts (local KEK fallback when Vault is down, default JWT secret).
# Never enable in production.
DEV_MODE=false

# Security & Tokens
# The app refuses to start with this placeholder unless DEV_MODE=true.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_this_in_production_super_secret_key_minimum_32_bytes_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# WebAuthn / Passkeys Configuration
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=ZeroTrustEvidenceExchange
WEBAUTHN_ORIGIN=http://localhost:8000

# Open Policy Agent (OPA) Sidecar
OPA_URL=http://localhost:8181/v1/data/case_access/allow

# HashiCorp Vault (Envelope Encryption)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root
VAULT_TRANSIT_KEY=case-dek-kek

# Field-level PII encryption key: base64 of 32 random bytes. Required.
# Generate one with: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=

# Telemetry & Threat Detection
ANOMALY_CONTAMINATION_RATE=0.05
